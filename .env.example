# API 只监听本机回环地址，公网访问由后续发布任务处理。
API_PORT=8787
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173

# Tunnel 默认关闭。单账号密码保护验收完成前，PUBLIC_ACCESS_READY 必须保持 false。
CLOUDFLARED_ENABLED=false
CLOUDFLARED_BIN=cloudflared.exe
CLOUDFLARED_CONFIG=./cloudflared/config.yml
CLOUDFLARED_CREDENTIALS_FILE=./cloudflared/tunnel-credentials.json
CLOUDFLARED_TUNNEL_NAME=
CLOUDFLARED_PUBLIC_URL=https://review.panspan.cloud
PUBLIC_ACCESS_READY=false

# 单账号密码门禁。密码只保存为 scrypt 哈希，不要把明文密码写入配置或进度文件。
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_FAILURE_LIMIT=5
# HTTPS 公网部署时设为 true；本机 http 验收保持 false。
AUTH_COOKIE_SECURE=false

# 数据库账号需要预先在 MySQL 中创建，密码只保存在本机 .env/.env.local。
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=knowledge_flashcards_app
DATABASE_PASSWORD=
DATABASE_NAME=knowledge_flashcards
DATABASE_CONNECTION_LIMIT=5

# 可以填写绝对路径；相对路径以项目根目录为基准。
DATA_DIR=./data
RESOURCES_DIR=./resources
BACKUPS_DIR=./backups

# AI Provider 密钥的本机加密口令。请使用随机长字符串，只保存在 .env/.env.local。
AI_PROVIDER_KEY_ENCRYPTION_SECRET=

# 学习助手要求 Provider 在首字期限内开始输出；已开始输出后，只有连续空闲超时才会中止。
AI_STUDY_ASSISTANT_FIRST_TOKEN_TIMEOUT_SECONDS=30
AI_STUDY_ASSISTANT_STREAM_IDLE_TIMEOUT_SECONDS=45
