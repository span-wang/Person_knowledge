{
  "name": "@knowledge-flashcards/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "test:import:integration": "node --import tsx --test test/import-real-mysql-http.test.ts",
    "test:review:integration": "node --import tsx --test test/review-real-mysql-http.test.ts",
    "test:hierarchy:integration": "node --import tsx --test test/hierarchy-real-mysql-http.test.ts",
    "test:m3:integration": "node --import tsx --test test/m3-real-mysql-http.test.ts",
    "test:edit-lock:integration": "node --import tsx --test test/edit-lock-real-mysql-http.test.ts",
    "test:ai-provider:integration": "node --import tsx --test test/ai-provider-real-mysql-http.test.ts",
    "test:ai-explanation:integration": "node --import tsx --test test/ai-explanation-http.test.ts",
    "test:data-governance:integration": "node --import tsx --test test/data-governance-http.test.ts",
    "test:backup:integration": "node --import tsx --test test/backup-real-mysql-http.test.ts",
    "test:m4:integration": "node --import tsx --test test/m4-real-mysql-http.test.ts",
    "test:catalog:integration": "node --import tsx --test test/catalog-real-mysql-http.test.ts",
    "test:question-import:integration": "node --import tsx --test test/question-import-real-mysql-http.test.ts",
    "test:question-bank:integration": "node --import tsx --test test/question-bank-real-mysql-http.test.ts",
    "migrate": "tsx src/migrate.ts",
    "db:check": "tsx src/database-check.ts",
    "storage:check": "tsx src/storage-check.ts"
  },
  "dependencies": {
    "@knowledge-flashcards/shared": "0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "mysql2": "^3.23.2",
    "parse5": "8.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.5",
    "unified": "^11.0.5",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
